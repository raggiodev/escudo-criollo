{
  "name": "escudo-criollo",
  "version": "0.2.0",
  "author": "Raggiodev (Fernando Andres Raggio) <contact@raggiodev.com>",
  "homepage": "https://escudo-criollo.raggiodev.com",
  "description": "Escudo 100% local contra tiendas online truchas: valida CUIT (Módulo 11), QR Data Fiscal ARCA/AFIP y limpia links.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "node -e \"const {execSync}=require('node:child_process');['zip','zip:edge','zip:firefox'].forEach(s=>execSync('npm run '+s,{stdio:'inherit'}))\"",
    "compile": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "tsx scripts/verify-core.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wxt": "^0.19.29"
  }
}