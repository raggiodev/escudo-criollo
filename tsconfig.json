{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src/**/*",
    "entrypoints/**/*",
    "scripts/**/*",
    "wxt.config.ts"
  ],
  "exclude": [".output", "node_modules"]
}
